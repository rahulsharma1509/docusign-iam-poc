# DocuSign demo environment values.
# For production, set these in Vercel project settings instead of committing them.

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=

# Keep the private key on one line with escaped newlines for local .env files.
# Do not commit a real key. Paste it only in your ignored local .env or Vercel env vars.
DOCUSIGN_PRIVATE_KEY="paste_escaped_private_key_here"

# Demo defaults. Use account.docusign.com and your production REST base path for prod.
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_PATH=demo.docusign.net/restapi

# Local dev server URL. On Vercel, use your production URL.
APP_BASE_URL=http://localhost:3000

# Optional. If empty, the backend derives APP_BASE_URL + /api/webhooks/docusign.
DOCUSIGN_WEBHOOK_URL=

# Optional. Use only if you configure DocuSign Connect HMAC validation.
DOCUSIGN_WEBHOOK_SECRET=

# Optional hardening controls.
# Comma-separated list. Use the app URL in production, for example https://your-app.vercel.app.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=5242880
